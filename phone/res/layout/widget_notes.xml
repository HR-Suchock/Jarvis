<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wn_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/wn_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.25"
            android:singleLine="true"
            android:text="NOTES"
            android:textColor="#19E3FF"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/wn_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="2dp"
            android:paddingLeft="12dp"
            android:paddingRight="4dp"
            android:paddingTop="2dp"
            android:text="+ ADD"
            android:textColor="#19E3FF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/wn_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/wn_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:paddingBottom="2dp" android:textColor="#E6F7FB" android:textSize="13sp" />
        <TextView android:id="@+id/wn_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:paddingBottom="2dp" android:textColor="#E6F7FB" android:textSize="13sp" />
        <TextView android:id="@+id/wn_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:paddingBottom="2dp" android:textColor="#E6F7FB" android:textSize="13sp" />
        <TextView android:id="@+id/wn_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:paddingBottom="2dp" android:textColor="#E6F7FB" android:textSize="13sp" />
        <TextView android:id="@+id/wn_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:paddingBottom="2dp" android:textColor="#E6F7FB" android:textSize="13sp" />
        <TextView android:id="@+id/wn_6" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="2" android:paddingBottom="2dp" android:textColor="#E6F7FB" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
